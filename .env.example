# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env — it is in .gitignore.
# Every value here is read at boot; missing ones fail loudly rather than defaulting silently.
# ---------------------------------------------------------------------------

# --- OpenAI (wiki embeddings, AI nodes) ----------------------------------
# Required only for vector search. The wiki works without it on SQLite FTS5.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBED_BATCH_SIZE=50
EMBED_MAX_RETRIES=3
EMBED_RETRY_DELAY_MS=1000

# --- Qdrant (vector store) -------------------------------------------------
# Required only for vector search. Local default matches the docker-compose service.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=n8n_knowledge_base
VECTOR_SIZE=1536
VECTOR_DISTANCE=Cosine

# --- n8n connection --------------------------------------------------------
# IMPORTANT — read brain/decisions/ADR-001-n8n-licence-blocks-hosted-saas.md first.
#
# This URL must point at an instance the CUSTOMER operates under their own licence.
# Do not point it at an instance we host and resell: n8n's Sustainable Use License
# does not permit providing n8n to third parties for profit.
#
# Per-customer values live in the database, not here. This is the local-dev default only.
N8N_BASE_URL=
N8N_API_KEY=
# Per-tenant connections are stored encrypted; this key encrypts them at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Auth ------------------------------------------------------------------
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Supabase pooled connection string, or a local Postgres.
DATABASE_URL=
DIRECT_URL=

# --- Billing ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=

# --- Observability ---------------------------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=